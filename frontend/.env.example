# Copy to `.env` (gitignored) and adjust. Vite only exposes VITE_-prefixed
# vars to client code (import.meta.env).

# Base URL of the backend API (no trailing slash). Copy this file to `.env`
# and point it at your local backend (e.g. http://localhost:8000) for dev.
#
# BUG-003: leave this UNSET in Vercel's dashboard for production. The code
# default is "/api", which routes through vercel.json's same-origin rewrite
# proxy to the Render backend — the browser only ever sees one site
# (veridical-app.vercel.app), so the SameSite=Lax session cookie survives
# every authenticated call. Setting this to the Render URL directly (the
# old prod config) makes the frontend call it cross-*site*, and SameSite=Lax
# cookies are never attached to cross-site fetch/XHR requests — every call
# after login reads as logged-out.
VITE_API_BASE_URL=
