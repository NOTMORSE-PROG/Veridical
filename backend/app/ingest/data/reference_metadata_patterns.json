{
  "_comment": "Conservative reference metadata grammar. These conventions may be overridden; ambiguous names, dates and quoted boundaries remain unassessed.",
  "version": "reference-metadata-v2",
  "quoted_title_pairs": [["\"", "\""], ["“", "”"]],
  "quoted_title_separators": ".,",
  "quoted_title_terminal_delimiters": ",",
  "access_note_prefixes": ["accessed", "retrieved", "last accessed", "visited"],
  "locator_labels": ["URL"],
  "doi_resolver_hosts": ["doi.org", "dx.doi.org"],
  "no_date_tokens": ["n.d."],
  "standard_identifier_pattern": "(?<![\\w/])(?P<series>[A-Z]{2,}(?:/[A-Z]{2,})*)\\s+(?P<number>\\d{3,6}(?:[.\\-]\\d+)*)(?::(?P<edition>\\d{4}))?(?![\\w.:\\-])",
  "months": ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December", "Jan", "Feb", "Mar", "Apr", "Jun", "Jul", "Aug", "Sep", "Sept", "Oct", "Nov", "Dec"],
  "name_particles": ["de", "del", "dela", "delos", "los", "las", "van", "von", "der", "den", "ter", "ten", "da", "das", "do", "dos", "di", "du", "la", "le", "y", "bin", "binti", "al", "el"],
  "corporate_author_words": ["university", "institute", "institution", "department", "council", "commission", "agency", "organization", "organisation", "association", "committee", "office", "laboratory", "team"]
}
