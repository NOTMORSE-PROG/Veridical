{
  "_comment": [
    "Section/heading detection patterns — DATA, not code (charter rule 7).",
    "An instructor-facing format that numbers or names sections differently",
    "is accommodated by editing this file (or pointing INGEST_PATTERNS_FILE",
    "at a copy), never by changing logic. Regexes are Python `re` syntax;",
    "`chapter`, `caption`, `toc_line_suffix` and list entries are matched",
    "case-insensitively; `top_numbered` is case-sensitive on purpose (its",
    "uppercase-start requirement filters numbered list items)."
  ],
  "chapter": "^chapter\\s+(?P<num>\\d+|[ivxlcdm]+)\\b\\.?\\s*(?P<title>.*)$",
  "numbered": "^(?P<num>\\d+(?:\\.\\d+)+)\\.?\\s+(?P<title>\\S.*)$",
  "top_numbered": "^(?P<num>\\d+)[.)]?\\s+(?P<title>[^a-z\\d\\W].*)$",
  "unnumbered_sections": [
    "abstract",
    "acknowledgment",
    "acknowledgments",
    "acknowledgement",
    "acknowledgements",
    "dedication",
    "approval sheet",
    "executive summary",
    "table of contents",
    "list of figures",
    "list of tables",
    "list of abbreviations",
    "definition of terms",
    "references",
    "bibliography",
    "glossary",
    "appendix",
    "appendices"
  ],
  "caption": "^(?:table|figure|fig\\.)\\s+\\d",
  "vision_cues": {
    "_comment": "An image is sent to the table/equation reading prompt only with one of these cues beside it. Most thesis images are figures, screenshots and photos, and most tables are typed text that is read without a model call. Distances are PDF points. An uncued image is recorded as not checked, never as read.",
    "table_caption": "^table\\s+(?:\\d|[ivxlc]+\\b)",
    "equation_number": "^\\(\\s*\\d+(?:\\.\\d+)*[a-z]?\\s*\\)$",
    "caption_gap_pts": 60,
    "column_slack_pts": 20
  },
  "toc_titles": [
    "table of contents",
    "contents",
    "list of figures",
    "list of tables"
  ],
  "toc_style_prefixes": [
    "toc",
    "table of figures",
    "tof"
  ],
  "reference_titles": [
    "references",
    "reference list",
    "bibliography",
    "works cited",
    "literature cited",
    "references and bibliography",
    "bibliography and references",
    "list of references",
    "references cited",
    "sources cited"
  ],
  "reuse_ancillary_titles": [
    "acknowledgment",
    "acknowledgments",
    "acknowledgement",
    "acknowledgements",
    "dedication",
    "approval sheet",
    "table of contents",
    "contents",
    "list of figures",
    "list of tables",
    "list of abbreviations"
  ],
  "reference_heading_prefix": "^(?:[IVXLCDM]+\\.|[1-9]\\d*(?:\\.\\d+)*[.)])\\s+",
  "reference_end_headings": [
    "^(?:appendix(?:es)?|appendices)(?:\\s+[A-Z0-9IVXLCDM]+)?(?:\\s*[:.\\-]\\s*.+)?$",
    "^glossary$",
    "^(?:supplement(?:ary|al)?(?:\\s+(?:material|materials|information|appendix))?)(?:\\s*[:.\\-]\\s*.+)?$"
  ],
  "reference_history_lines": [
    "^(?:received|submitted)\\s+\\d{1,2}\\s+[^\\d;,]+\\s+\\d{4}(?:\\s*;\\s*(?:revised|accepted)\\s+\\d{1,2}\\s+[^\\d;,]+\\s+\\d{4})+\\.?$",
    "^(?:received|submitted)\\s+\\d{4}-\\d{2}-\\d{2}(?:\\s*;\\s*(?:revised|accepted)\\s+\\d{4}-\\d{2}-\\d{2})+\\.?$"
  ],
  "reference_end_heading_style": {
    "min_bold_ratio": 0.6,
    "min_font_scale": 1.2
  },
  "reference_url_geometry_tolerance_pts": 2.0,
  "standalone_heading_label": "^\\.?(?:[1-9]\\d*(?:\\.\\d+)*|[IVXLCDM]+)[.)]?$",
  "vision_priority_sections": [
    "results",
    "analysis",
    "findings",
    "discussion",
    "testing",
    "evaluation",
    "methodology"
  ],
  "furniture": [
    "^\\d{1,4}$",
    "^page\\s+\\d+(\\s+of\\s+\\d+)?$"
  ],
  "toc_line_suffix": "\\d{1,4}\\s*$",
  "title_page": {
    "_comment": [
      "V-063: deterministic title-page extraction (group name, members,",
      "program) -- data, not code, same as every other pattern in this",
      "file. `degree_program_map` keys are matched as substrings of the",
      "text AFTER `degree_prefix`, case-insensitive; values must be real",
      "Program.name rows (seeded by migration 0025) or the match is",
      "silently skipped (never fabricates a program that doesn't exist)."
    ],
    "by_markers": ["by:", "by"],
    "adviser_markers": ["adviser:", "adviser"],
    "degree_prefix": "bachelor of science in",
    "degree_program_map": {
      "information technology": "IT",
      "computer science": "CS"
    },
    "title_separators": [":", " - "]
  }
}
