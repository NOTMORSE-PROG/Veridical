    "constraint_patterns": ["\\s*(?:(?:the|a|an|its|our)\\s+)?(?:[a-z][a-z0-9_-]*\\s+){1,8}(?:was|were|is|are|remained)\\s+(?:unavailable|insufficient|unfunded|(?P<constraint_negation>not)\\s+(?:actually\\s+)?available)(?:\\s+(?:during|throughout|for)\\s+(?:(?:the|this)\\s+)?(?:study|evaluation|testing|trial|implementation))?\\s*[.!]?\\s*"],
    "veto_patterns": [
