{
  "_note": "Criteria judged from the reference list after the citation check (V-098). A criterion matches a strategy by its own level descriptors, never by its name: at least min_levels of its levels must match one of the strategy's patterns. The first matching strategy wins.",
  "strategies": [
    {
      "name": "reference_inventory",
      "level_patterns": [
        "\\bincludes?\\s+(?:more\\s+than\\s+)?\\w+\\s+major\\s+references?\\b"
      ],
      "min_levels": 2
    },
    {
      "name": "reference_quality",
      "level_patterns": [
        "\\bpeer[\\s\\u002d\\u2010-\\u2015\\u2212]*review(?:ed)?\\b"
      ],
      "min_levels": 2
    }
  ],
  "count_conditions": [
    {
      "kind": "major_more_than",
      "pattern": "\\bincludes?\\s+more\\s+than\\s+(?P<n>\\w+)\\s+major\\s+references?\\b"
    },
    {
      "kind": "major_at_least",
      "pattern": "\\bincludes?\\s+(?P<n>\\w+)\\s+major\\s+references?\\b"
    },
    {
      "kind": "internet_at_most",
      "pattern": "\\bno\\s+more\\s+than\\s+(?P<n>\\w+)\\s+internet\\s+sites?\\b"
    }
  ],
  "number_words": {
    "zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
    "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11,
    "twelve": 12, "fifteen": 15, "twenty": 20
  },
  "_types_note": "Provider type tags (app/external/work_type.py) grouped into classes. A tag in no class makes an identified work 'other': it counts neither as a major reference nor as an internet site.",
  "type_classes": {
    "peer_reviewed": [
      "crossref:journal-article",
      "crossref:proceedings-article",
      "s2:JournalArticle",
      "s2:Conference",
      "s2:Review",
      "datacite:JournalArticle",
      "datacite:ConferencePaper"
    ],
    "book": [
      "crossref:book",
      "crossref:book-chapter",
      "crossref:monograph",
      "crossref:edited-book",
      "crossref:reference-book",
      "s2:Book",
      "s2:BookSection",
      "datacite:Book",
      "datacite:BookChapter",
      "openlibrary:book",
      "gbooks:book"
    ]
  },
  "major_classes": ["peer_reviewed", "book"],
  "_confirmed_note": "Only a lookup whose identity was confirmed says what the entry is.",
  "confirmed_statuses": ["existence_confirmed", "retracted", "corrected"],
  "_web_note": "An entry no catalogue identified, that gives a web address and says it was retrieved or accessed online, is counted as an internet site.",
  "web_entry_cues": [
    "\\bretrieved\\s+(?:from|on)\\b",
    "\\baccessed\\b",
    "\\bavailable\\s+(?:at|from|online)\\b",
    "\\bonline\\s*\\]",
    "\\[\\s*online\\b"
  ],
  "quality_readings": 2
}
