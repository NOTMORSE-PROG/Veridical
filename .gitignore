# ── Internal docs: local-only by project policy ─────────────────
# The project's working memory (AI charter, context brain, ticket board,
# design sources) is deliberately NOT committed. Only public docs
# (README.md, FEATURES.md) and code are tracked. See README.md.
/*.md
!/README.md
!/FEATURES.md
context/
tickets/
design/
*.pdf
# ...except the synthetic ingestion fixtures — they ARE the CI gate
# (V-008; real manuscripts stay uncommittable, D-007).
!backend/tests/fixtures/ingest/*.pdf

# ── Secrets / environment ────────────────────────────────────────
.env
.env.*
!.env.example
*.key
config/secrets.yaml
config/keys.yaml

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ── Node / frontend ──────────────────────────────────────────────
node_modules/
frontend/dist/
.vite/

# ── Runtime data (anchored: keeps src/**/data importable) ────────
/data/
# Raw extraction store (holds manuscript text — never committed);
# backend/app/ingest/data/ (pattern files) stays tracked.
/backend/data/
*.log

# ── Tooling artifacts ─────────────────────────────────────────────
.codex/
.playwright-mcp/
# Agent/session screenshots land at the repo root (ui-designer,
# ux-critic, professor all write there by default). They show real
# manuscript content, so they are local-only under D-007 — the same
# reason *.pdf is ignored above. Root-anchored so committed UI assets
# under frontend/public/ are unaffected. Found untracked AND
# un-ignored by the 2026-08-16 whole-product audit (Track C, C20):
# a single `git add -A` would have published them.
/*.png
/*.jpg
/*.jpeg
/*.webp

# ── OS / editor ──────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/

# Progress-report decks / generated presentation assets (internal, not part of the shipped product)
presentation/
