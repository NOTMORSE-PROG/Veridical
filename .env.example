# VERIDICAL environment — copy to `.env` and adjust. NEVER commit `.env`.
# Every variable the app reads is documented here (V-001 acceptance rule).

# dev | prod — reported by /health, used for environment-specific behavior.
VERIDICAL_ENV=dev

# 1 = swap the Gemini client for the fixture-backed fake (app/llm/fake.py).
# Zero API keys, zero quota burn; this is the default for dev and tests.
VERIDICAL_FAKE_LLM=1

# Local docker-compose Postgres (published on host port 5433 — 5432 is
# often taken by a native Postgres). In prod this is the Neon DSN instead.
DATABASE_URL=postgresql://veridical:veridical@localhost:5433/veridical

# Only required when VERIDICAL_FAKE_LLM=0 and the real client exists (V-009).
GEMINI_API_KEY=

# Seconds per attempt for the /health DB probe (2 attempts; generous
# because Neon autosuspends and needs time to wake).
DB_HEALTH_TIMEOUT=5.0

# Dimensionality of the manuscript embedding column (pgvector). Provisional
# until the embedding model is chosen; must stay <= 2000 or the vector index
# cannot be built. NOTE: the value is baked into the DB at migration time —
# changing it later requires a new migration, not just an env edit.
EMBEDDING_DIM=768

# ---- Ingestion (V-004) ------------------------------------------------------
# All defaults live in backend/app/config.py; override only what you need.

# Local directory for derived extraction JSON (<manuscript_id>.extraction.json).
DATA_DIR=./data
# Path to a custom heading-patterns data file (section-name synonyms,
# numbering regexes). Empty = packaged default
# (backend/app/ingest/data/heading_patterns.json).
INGEST_PATTERNS_FILE=
# Lines longer than this never count as headings.
INGEST_HEADING_MAX_CHARS=120
# Minimum bold-character share for a line to count as bold.
INGEST_BOLD_RATIO_MIN=0.8
# Points above body font size for a line to count as oversized.
INGEST_HEADING_SIZE_DELTA=1.0
# Embedded-TOC outlines below this entry count are ignored.
INGEST_TOC_MIN_ENTRIES=4
# Minimum share of embedded-TOC entries findable on their destination page;
# below it the outline is discarded and heuristics run instead.
INGEST_TOC_MATCH_MIN_RATIO=0.5
# A page continues a TOC region while >= this share of its lines end in
# page numbers / dot leaders.
INGEST_TOC_LINE_RATIO=0.25
# Running header/footer detection: page-height fraction scanned top/bottom,
# minimum share of pages a line must repeat on, minimum document length.
INGEST_FURNITURE_BAND_RATIO=0.12
INGEST_FURNITURE_PAGE_RATIO=0.4
INGEST_FURNITURE_MIN_PAGES=3
# Below this many selectable chars/page the file is treated as a scan
# (image_only state, limited checks — not an error).
INGEST_IMAGE_ONLY_CHARS_PER_PAGE=50
# Vision pass over embedded images (F1.3): hard cap on model calls per
# manuscript, minimum image area (square points; smaller = decorative,
# skipped), and crop rendering DPI.
INGEST_VISION_MAX_IMAGES=12
INGEST_VISION_MIN_AREA_PTS=5000.0
INGEST_VISION_CROP_DPI=150
# Upload size ceiling in MB — enforced while streaming, rejected early
# with a clear message (413 too_large).
MAX_UPLOAD_MB=40

# ---- LLM queue (V-009) -------------------------------------------------------
# Pinned model id (not "-latest" — golden-set comparisons need a stable
# model). gemini-2.5-flash/-lite 404 for new API keys as of 2026-07-25
# ("no longer available to new users") — gemini-3.5-flash is current.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_REQUEST_TIMEOUT_SECONDS=60.0
# Governor: serialize calls to this req/min ceiling; count daily usage
# against this req/day ceiling (RESEARCH.md §1 free-tier numbers, w/ margin).
LLM_RPM=12
LLM_DAILY_QUOTA=1400
# Gemini's own reset boundary (NOT local time).
LLM_QUOTA_RESET_TIMEZONE=America/Los_Angeles
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0

# ---- Rubric decomposition validation gate (V-011) ----------------------------
RUBRIC_PARSE_MAX_RETRIES=2
RUBRIC_COVERAGE_MIN_RATIO=0.6
RUBRIC_COVERAGE_MIN_LINE_CHARS=20
RUBRIC_COVERAGE_WORD_OVERLAP_RATIO=0.3

# ---- CORS (V-048) ------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty = no CORS
# middleware (dev has no cross-origin caller yet). Production sets this to
# exactly the Vercel production origin, e.g.:
#   CORS_ALLOWED_ORIGINS=https://veridical.vercel.app
CORS_ALLOWED_ORIGINS=
