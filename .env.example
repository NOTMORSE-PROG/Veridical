# VERIDICAL environment — copy to `.env` and adjust. NEVER commit `.env`.
# Every variable the app reads is documented here (V-001 acceptance rule).

# dev | prod — reported by /health, used for environment-specific behavior.
VERIDICAL_ENV=dev
# BUG-418: the build's commit, reported on /health. Render sets RENDER_GIT_COMMIT
# itself; set DEPLOYED_COMMIT only on hosts that do not. Leave empty locally.
DEPLOYED_COMMIT=

# 1 = swap the Gemini client for the fixture-backed fake (app/llm/fake.py).
# Zero API keys, zero quota burn; this is the default for dev and tests.
VERIDICAL_FAKE_LLM=1

# Local docker-compose Postgres (published on host port 5433 — 5432 is
# often taken by a native Postgres). In prod this is the Neon DSN instead.
DATABASE_URL=postgresql://veridical:veridical@localhost:5433/veridical

# Only required when VERIDICAL_FAKE_LLM=0 and the real client exists (V-009).
GEMINI_API_KEY=

# V-052 (BYOK): master key encrypting each instructor's own pasted Gemini
# key at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = the BYOK feature is unavailable on this deployment (settings
# hides the input). Never share this value; rotating it requires manually
# re-encrypting every stored instructor key (not automated).
BYOK_ENCRYPTION_KEY=

# Timeout (seconds) for the one-shot key-validation probe (GET /models,
# spends no generation quota) run before an instructor's pasted key is saved.
BYOK_PROBE_TIMEOUT_SECONDS=15.0

# Seconds per attempt for the /health DB probe (2 attempts; generous
# because Neon autosuspends and needs time to wake).
DB_HEALTH_TIMEOUT=5.0

# Dimensionality of the manuscript embedding column (pgvector). Model
# finalized at V-036 pickup: potion-base-8M, 256 dims (confirmed via
# StaticModel.dim, DECISIONS.md D-011 addendum). Must stay <= 2000 or the
# vector index cannot be built. NOTE: the value is baked into the DB at
# migration time — changing it later requires a new migration (0014), not
# just an env edit.
EMBEDDING_DIM=256

# ---- Ingestion (V-004) ------------------------------------------------------
# All defaults live in backend/app/config.py; override only what you need.

# Local directory for derived extraction JSON (<manuscript_id>.extraction.json).
DATA_DIR=./data
# Path to a custom heading-patterns data file (section-name synonyms,
# numbering regexes). Empty = packaged default
# (backend/app/ingest/data/heading_patterns.json).
# Optional heading-pattern JSON. reuse_ancillary_titles is an exact normalized
# title list: these headings alone do not define substantive F7 chapters.
# Older files inherit the shipped list; an explicit [] disables that fallback.
INGEST_PATTERNS_FILE=
# Lines longer than this never count as headings.
INGEST_HEADING_MAX_CHARS=120
# Source-preserving guarded reader; select native_regions_v1 for controlled UAT.
# Legacy stores remain unassessed; changing this never clears persisted issues.
INGEST_READING_ORDER_STRATEGY=native_regions_v1
INGEST_READING_ORDER_MAX_LINES_PER_PAGE=4000
INGEST_READING_ORDER_MAX_NODES_PER_PAGE=8000
INGEST_READING_ORDER_MAX_DEPTH=32
INGEST_READING_ORDER_MAX_PAIR_COMPARISONS=100000
# Strict native rectangular-cell source witnesses; unsupported layouts stay unresolved.
# These bound additional adapter work, not native PDF parser/detector memory.
INGEST_NATIVE_TABLE_ORDER_ENABLED=true
INGEST_NATIVE_TABLE_MAX_TABLES_PER_PAGE=16
INGEST_NATIVE_TABLE_MAX_CELLS_PER_PAGE=4096
INGEST_NATIVE_TABLE_MAX_CHARACTERS_PER_PAGE=100000
INGEST_READING_ORDER_GEOMETRY_TOLERANCE_PTS=0.01
INGEST_READING_ORDER_ROW_TOLERANCE_PTS=2.0
INGEST_READING_ORDER_DIRECTION_TOLERANCE=0.01
INGEST_READING_ORDER_MIN_BASELINE_SEPARATION_EM=1.0
# Optional local PDF table/figure recovery. Empty paths = disabled. Install the
# separate worker environment and verified model artifacts before enabling.
# This needs more RAM than Render Free; R2/Neon storage is not worker memory.
# Absolute operator-owned paths only; never supplied by an upload request.
# One worker per DATA_DIR; RSS/output bounds are sampled watchdogs, not an OS
# security sandbox or a guarantee that peak allocation cannot exceed a sample.
INGEST_RECOVERY_PYTHON=
INGEST_RECOVERY_MODELS_DIR=
# Empty = packaged, versioned model/file manifest.
INGEST_RECOVERY_MANIFEST_FILE=
INGEST_RECOVERY_MAX_PAGES=8
INGEST_RECOVERY_TIMEOUT_SECONDS=120
INGEST_RECOVERY_CLEANUP_TIMEOUT_SECONDS=5
INGEST_RECOVERY_MEMORY_MB=2048
INGEST_RECOVERY_POLL_SECONDS=0.1
INGEST_RECOVERY_THREADS=2
INGEST_RECOVERY_MAX_OUTPUT_MB=16
INGEST_RECOVERY_MAX_REGIONS_PER_PAGE=64
INGEST_RECOVERY_MAX_CELLS_PER_TABLE=2000
INGEST_RECOVERY_MAX_FRAGMENTS_PER_CELL=12
INGEST_RECOVERY_MAX_MAPPING_COMPARISONS=100000
# Bounded untrusted hyperlink inventory, never fetched during ingestion.
INGEST_URI_MAX_LINKS=2000
INGEST_URI_MAX_CHARS=4096
# Minimum bold-character share for a line to count as bold.
INGEST_BOLD_RATIO_MIN=0.8
# Points above body font size for a line to count as oversized.
INGEST_HEADING_SIZE_DELTA=1.0
# Embedded-TOC outlines below this entry count are ignored.
INGEST_TOC_MIN_ENTRIES=4
# Minimum share of embedded-TOC entries findable on their destination page;
# below it the outline is discarded and heuristics run instead.
INGEST_TOC_MATCH_MIN_RATIO=0.5
# A page continues a TOC region while >= this share of its lines end in
# page numbers / dot leaders.
INGEST_TOC_LINE_RATIO=0.25
# Running header/footer detection: page-height fraction scanned top/bottom,
# minimum share of pages a line must repeat on, minimum document length.
INGEST_FURNITURE_BAND_RATIO=0.12
INGEST_FURNITURE_PAGE_RATIO=0.4
INGEST_FURNITURE_MIN_PAGES=3
# Below this many selectable chars/page the file is treated as a scan
# (image_only state, limited checks — not an error).
INGEST_IMAGE_ONLY_CHARS_PER_PAGE=50
# Vision pass over embedded images (F1.3): hard cap on model calls per
# manuscript, minimum image area (square points; smaller = decorative,
# skipped), and crop rendering DPI.
INGEST_VISION_MAX_IMAGES=12
INGEST_VISION_MIN_AREA_PTS=5000.0
INGEST_VISION_CROP_DPI=150
# Upload size ceiling in MB — enforced while streaming, rejected early
# with a clear message (413 too_large).
MAX_UPLOAD_MB=40
# Exact-file SHA-256 reads use this many bytes per chunk. The legacy recovery
# command handles only this many eligible rows per invocation unless its
# operator supplies an explicit --batch-size, which cannot exceed the
# separate configurable safety ceiling.
CONTENT_HASH_READ_CHUNK_BYTES=1048576
CONTENT_HASH_READ_MAX_CHUNK_BYTES=8388608
CONTENT_HASH_BACKFILL_BATCH_SIZE=25
CONTENT_HASH_BACKFILL_MAX_BATCH_SIZE=100
CONTENT_HASH_BACKFILL_PROCESS_CEILING=1000
# DOCX is a zip archive — the upload cap above only bounds the COMPRESSED
# size on disk; a crafted archive can expand far beyond that in memory
# during parsing (zip-bomb class risk, BUG-005/D-020). BUG-159: this
# ceiling used to be 500MB with a comment claiming it bounded worst-case
# memory against the free-tier's 512MB container ceiling — arithmetically
# false, since that ceiling is for the whole container, and this file's
# own measured headroom (below) is only ~160-196MB. 150MB sits inside
# that headroom with margin, still far above any real manuscript's
# embedded images. Verified against the REAL decompressed bytes, not just
# this declared ceiling — a lying central directory can't bypass it.
MAX_DOCX_UNCOMPRESSED_MB=150
# Native source-image display bounds. Unsupported/over-limit occurrences are
# disclosed, never silently treated as assessed. PNG/JPEG only; no linked fetch.
DOCX_IMAGE_MAX_BYTES=16777216
# Maximum ZIP central-directory bytes, checked before metadata allocation on
# ingestion and source reads. Independent of compressed/decompressed size.
DOCX_ZIP_DIRECTORY_MAX_BYTES=1048576
DOCX_IMAGE_MAX_PIXELS=25000000
DOCX_IMAGE_MAX_COUNT=200
# Bound metadata-object expansion in PNG/JPEG header parsing, before allocating it.
DOCX_IMAGE_MAX_METADATA_SEGMENTS=2048
DOCX_IMAGE_TOTAL_MAX_BYTES=67108864
# Bound streamed original-XML occurrence verification for each source image.
# Only the prefix through that drawing is read; over-limit sources stay unavailable.
DOCX_IMAGE_SOURCE_XML_MAX_BYTES=16777216
DOCX_IMAGE_SOURCE_XML_MAX_NODES=200000
# Per-instructor image reads in ACTION_RATE_LIMIT_WINDOW_SECONDS. This is
# separate from provider-spending actions and shared by report/Library readers.
DOCX_SOURCE_IMAGE_RATE_LIMIT_MAX_ATTEMPTS=400
# BUG-180: file size (above) bounds the wrong dimension for a PDF — a
# 50,000-page file measured well inside a 40MB cap. Page count is
# checked before a single page is parsed; the timeout is a second,
# independent backstop (bounds how long the request waits, not the
# underlying threadpool work itself — Python can't cancel a running
# thread).
INGEST_MAX_PAGES=500
INGEST_EXTRACTION_TIMEOUT_SECONDS=60.0
# Per-process preparation admission; only 1 is supported by the current native
# threaded parser topology. Rejection has no server queue. A cancelled/timed-out
# request holds its slot until native work ends. This does not cap process RAM,
# other PDF render operations, multiple workers/replicas or hung-thread lifetime.
DOCUMENT_PREPARATION_SLOTS=1
# Review Desk and New Check manuscript-list paging. The default must be at
# least 1 and no larger than the maximum. New Check currently requests the
# maximum until its picker is server-paginated.
MANUSCRIPT_LIST_DEFAULT_PAGE_SIZE=50
MANUSCRIPT_LIST_MAX_PAGE_SIZE=200
# Audit history paging. The default must be at least 1 and no larger than
# the maximum; the API rejects larger requests before the audit-list query.
AUDIT_LIST_DEFAULT_PAGE_SIZE=50
AUDIT_LIST_MAX_PAGE_SIZE=200
# This is a configurable request-safety boundary, not a claim about tested
# audit-history capacity or query performance.
AUDIT_LIST_MAX_PAGE=10000

# ---- LLM queue (V-009) -------------------------------------------------------
# Legacy compatibility setting; the application routes through the model pool.
# A requested model ID does not establish which provider version served it.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_REQUEST_TIMEOUT_SECONDS=60.0
# ---- Model pool (V-049, D-014) ----
# Ordered requested models, configured local budgets and historical aliases.
# Blank uses backend/app/llm/data/model_pool.json. Override membership, order
# or limits without changing code. Configured totals are not measured current
# provider allowance. Apply cache migration and drain old writers at cutover.
LLM_MODEL_POOL_FILE=
# Legacy single-model local limits retained from July 26 observations.
# The old ~1,500/day assumption was retracted then. These defaults are not
# a fresh measurement or current provider entitlement.
LLM_RPM=10
LLM_DAILY_QUOTA=20
# Gemini's own reset boundary (NOT local time).
LLM_QUOTA_RESET_TIMEZONE=America/Los_Angeles
LLM_MAX_RETRIES=3
# Cache namespace changes when structured-output/evidence validation changes.
# Old cached responses remain stored but cannot satisfy the new contract.
LLM_CACHE_CONTRACT_VERSION=evidence-v2
# Necessary source-scope checks supplement model support; no relevance score.
# Versioned obligation patterns also withhold external-property and collection-wide
# ratings without independent assessment records. Pattern language coverage is bounded;
# this is an abstention safeguard, not proof of semantic accuracy.
SEMANTIC_EVIDENCE_SCOPE_PATTERNS_FILE=app/checks/data/semantic_evidence_scopes.json
# Selective non-scoring figure readings: at most two calls per selected image
# (observation + visual support check). Opening/reopening never starts a call.
INGEST_FIGURE_READING_ENABLED=1
INGEST_FIGURE_MAX_IMAGES=2
INGEST_FIGURE_CAPTION_LOOKAHEAD=4
LLM_RETRY_BASE_SECONDS=1.0
# BUG-162: the response cache (D-011) is keyed on prompt content, so a
# normal re-run of the same manuscript/rubric is a cache REPLAY, not an
# independent regrading -- correct for saving quota, but it means there is
# no supported way to MEASURE run-to-run grading stability with this left
# off. Off (0) by default; set to 1 ONLY for a deliberate one-off stability
# probe (backend/scripts/stability_probe.py, run as `uv run python -m
# scripts.stability_probe` from backend/) -- spends real quota on every
# call, every time, do not leave this on.
LLM_CACHE_BYPASS=0
# Full-source semantic review limit. Overflow escalates without grading or
# silently dropping text. Evidence support is checked once per semantic batch.
SEMANTIC_CONTEXT_MAX_CHARS=450000
# Pages whose reading order is unresolved (complex tables, overlapping layouts)
# are left out of rubric grading and the integrity checks, and named on every
# result, while they are at most this share of the manuscript (0-1). Above it
# those analyses do not run and the instructor reviews the paper directly.
ANALYSIS_UNREAD_PAGES_MAX_RATIO=0.25
# Pacing estimate for per-minute input-token budgets (model_pool.json "tpm").
LLM_CHARS_PER_TOKEN=4.0
LLM_TOKENS_PER_IMAGE=258
# Each bounded batch has two grading calls and at most one support-review call,
# plus existing conditional retries/tie-breaks. Saved completed batches resume.
SEMANTIC_BATCH_MAX_CRITERIA=20
# Whole-envelope validation gets at most the existing one retry. Identifiable
# invalid/missing items use one repair per affected criterion, at most this many
# per primary pass and never more than the requested batch size. Every physical
# attempt still reserves provider quota. Unrecovered items remain unassessed.
SEMANTIC_BATCH_VALIDATION_ATTEMPTS=2
SEMANTIC_ITEM_RECOVERY_MAX_CRITERIA=20
# Grading evidence: a proposal that adds a leading/trailing "..." or differs
# from the source only by rendering (ligatures, case, line-break spacing) is
# stored as the source's own text when the remaining core has at least this
# many characters and exactly one supported location.
SEMANTIC_OMISSION_CORE_MIN_CHARS=40
# A quotation found verbatim at several locations (abstract restated in Chapter 1,
# a journal-article copy in an appendix) is anchored to its first location when
# it has at least this many characters; shorter repeated phrases stay ambiguous.
SEMANTIC_REPEATED_QUOTE_MIN_CHARS=80
# Pause after each page image a PDF export renders, as a multiple of its render
# time (0 = none). Set about 1 on hosts with a fraction of one CPU (Render free)
# so exports do not starve request handling and health checks.
EXPORT_RENDER_PAUSE_RATIO=0
# Reuse a /health database check for this many seconds (0 = every request).
# Set about 30 on hosts whose platform probes /health every few seconds.
HEALTH_DB_CHECK_CACHE_SECONDS=0
# Replace pooled database connections older than this many seconds (-1 = never).
DB_POOL_RECYCLE_SECONDS=300
# Cache identity for indexed local recovery, independent of prompt/pass/phase.
SEMANTIC_GRADING_RESPONSE_CONTRACT=indexed-item-recovery-v1
# Exact DOI registry lookup only; misses never trigger a title substitution.
CITATION_DOI_PROVIDERS=["crossref","datacite"]
# CITATION_METADATA_TITLE_POLICY_FILE: optional validated DOI-title policy JSON.
# Default: packaged metadata_title_policy.json; restart after policy changes.
# Canonical Unicode/SI spelling only; ambiguous typography is unassessed.
CITATION_DOI_SOURCE_URL_TEMPLATE=https://doi.org/{doi}
CITATION_REGISTRY_RECORD_URL_TEMPLATES={"crossref":"https://api.crossref.org/works/{doi}","datacite":"https://api.datacite.org/dois/{doi}"}
DATACITE_BASE_URL=https://api.datacite.org
DATACITE_RPM=60

# ---- Rubric decomposition validation gate (V-011) ----------------------------
RUBRIC_PARSE_MAX_RETRIES=2
RUBRIC_COVERAGE_MIN_RATIO=0.6
RUBRIC_COVERAGE_MIN_LINE_CHARS=20
RUBRIC_COVERAGE_WORD_OVERLAP_RATIO=0.3
# Bounded citation extraction; values retained from the reviewed candidate.
# Resource budget for structured metadata only; complete raw references remain stored.
REFERENCE_METADATA_MAX_CHARS=8192
# Abort optional printed-DOI recovery before an oversized geometry cross-product.
# This is a work budget, not an evidence-confidence or accuracy threshold.
REFERENCE_DOI_MAX_GEOMETRY_COMPARISONS=100000
# Optional override of packaged reference date/name/paired-title conventions.
# Quoted-title rerun evidence records the version and effective config SHA256.
# REFERENCE_METADATA_PATTERNS_FILE=
REFERENCE_UNSEPARATED_AUTHOR_MAX_TOKENS=3
CITATION_AUTHOR_MAX_CHARS=160
CITATION_AUTHOR_MAX_TOKENS=8
CITATION_UNSEPARATED_AUTHOR_MAX_TOKENS=3
CITATION_PARENTHETICAL_GROUP_MAX_CHARS=4000
CITATION_PARENTHETICAL_ENTRY_MAX_CHARS=320
CITATION_CLAIM_EXCERPT_MAX_CHARS=480
CITATION_IN_TEXT_MAX_MATCHES=2000
CITATION_WRAP_FONT_SIZE_TOLERANCE_PT=0.5
NUMERIC_CITATION_MAX_RANGE_SPAN=20
# NUMERIC_CITATION_CONTEXT_FILE: optional alternate packaged context data path.
# Conservative v4 scale/checklist draft guards (not accuracy thresholds).
RUBRIC_FEEDBACK_CRITERION_MAX_CHARS=60
RUBRIC_ATOMICITY_MIN_ITEMS=10
RUBRIC_ATOMICITY_MIN_RATIO=0.35
# RUBRIC_LIST_ITEM_PATTERN uses the default bullet/checkbox/number pattern in Settings.

# ---- Structural check engine (V-016) -----------------------------------------
# Path to custom criterion-matching keyword / bound-phrase data files.
# Empty = packaged defaults (backend/app/checks/rules/data/*.json).
STRUCTURAL_KEYWORDS_FILE=
STRUCTURAL_BOUND_PATTERNS_FILE=
# A declared margin within this many points of the criterion's stated
# value still counts as meeting it (real documents are never pixel-exact).
STRUCTURAL_MARGIN_TOLERANCE_PTS=6.0
# Share of reference-list entries that must show the APA-ish
# year-in-parentheses pattern before the citation-style rule passes.
STRUCTURAL_CITATION_STYLE_MIN_RATIO=0.7
# Share of tables that must carry a caption before the table-formatting
# rule passes.
STRUCTURAL_TABLE_CAPTION_MIN_RATIO=0.8
# Section word-count rule: a miss within this many words of the stated limit
# is escalated to the instructor instead of failed; a section spanning more
# pages than the max is escalated because its end could not be confirmed.
STRUCTURAL_WORD_COUNT_TOLERANCE_WORDS=5
STRUCTURAL_WORD_COUNT_MAX_SPAN_PAGES=3
# Lines a wrapped section title may occupy when its heading is located.
STRUCTURAL_WORD_COUNT_HEADING_MAX_LINES=3

# ---- Tier-0 signal layer (V-016, D-011 shadow mode) --------------------------
# Flesch Reading Ease band; type-token vocabulary-diversity floor. SHADOW
# ONLY (D-012) — recorded for future promotion evaluation, never decides
# an outcome on its own.
SIGNAL_READABILITY_FLESCH_MIN=0.0
SIGNAL_READABILITY_FLESCH_MAX=70.0
SIGNAL_VOCAB_DIVERSITY_MIN=0.25

# ---- Aggregation & scoring (V-019, F8.1) -------------------------------------
# Terminal semantic service outages leave ungraded criteria for instructor review
# and continue remaining checks under their existing assessment-limit policies.
# Safe saved criterion wording; never include provider diagnostics or secrets.
PIPELINE_API_DOWN_DEGRADED_REASON="Not graded by AI. The AI service was unavailable, so no completed grade was recorded for this criterion. AI grading of this criterion will not retry automatically in this run. If a report is produced, review the manuscript and record your own judgment there. You can also start a new check later."
# Safe report-facing reasons. Never include key material or raw provider diagnostics.
PIPELINE_AI_NOT_CONFIGURED_DEGRADED_REASON="Not graded by AI. No usable AI configuration was available for this check, so no completed AI grade was recorded for this criterion. AI grading of this criterion will not retry automatically in this run. If a report is produced, review the manuscript and record your own judgment there. You can also start a new check after AI configuration is available."
PIPELINE_AI_KEY_REJECTED_DEGRADED_REASON="Not graded by AI. The configured AI key was rejected during an AI request, and no applicable alternative completed that request. No completed AI grade was recorded for this criterion. AI grading of this criterion will not retry automatically in this run. If a report is produced, review the manuscript and record your own judgment there. You can also start a new check after AI access is restored."
# Three-way status thresholds — visible in the report payload, never a
# black box.
SCORING_READY_MIN_SCORE=85.0
SCORING_NOT_READY_MAX_SCORE=60.0
# Capped per-flag severity deductions (integrity checks arrive V4/V5;
# mechanism built and tested now).
SCORING_FLAG_DEDUCTION_HIGH=15.0
SCORING_FLAG_DEDUCTION_MED=8.0
SCORING_FLAG_DEDUCTION_LOW=3.0
SCORING_FLAG_DEDUCTION_CAP=40.0
# Weight importance display (D-023): a criterion's weight is bucketed into
# Low/Medium/High by its ratio to the rubric's equal-split average, never
# shown as a bare percentage (weights are relative, no required total).
WEIGHT_IMPORTANCE_LOW_MAX_RATIO=0.5
WEIGHT_IMPORTANCE_HIGH_MIN_RATIO=1.5
# Resolution reason (BUG-096): the "Reason (required)" field on an
# escalation resolution used to accept a single character, which was then
# published verbatim to the report, the PDF, and the public share link.
RESOLUTION_REASON_MIN_LENGTH=10
# Explicit saved-judgment revisions. Historical reasons are never truncated.
JUDGMENT_REVISION_REASON_MAX_LENGTH=1000
JUDGMENT_HISTORY_PAGE_SIZE=20
JUDGMENT_HISTORY_MAX_PAGE_SIZE=100
JUDGMENT_HISTORY_CURSOR_MAX_LENGTH=1024

# ---- Check-run orchestration (V-018) -----------------------------------------
PIPELINE_WORKER_POLL_SECONDS=5.0
PIPELINE_API_DOWN_RETRY_SECONDS=300.0
# BUG-144: a check_run claim older than this is treated as abandoned
# (crashed process) and can be re-claimed by either driver.
PIPELINE_CLAIM_STALE_SECONDS=600.0
# BUG-427: independently renew the global execution lease; renewal and bounded
# coordination must allow at least two attempts before the stale threshold.
PIPELINE_CLAIM_RENEW_SECONDS=30.0
PIPELINE_COORDINATION_TIMEOUT_SECONDS=5.0
# Shared by every process, signed int32 pair; distinct from bigint manuscript
# advisory locks. Restart all executors together when changing this protocol.
PIPELINE_ADMISSION_LOCK_NAMESPACE=427
PIPELINE_ADMISSION_LOCK_KEY=1
# BUG-181: a run still going after this many seconds fails honestly
# (TerminalFailure) instead of holding up every other queued check
# indefinitely. Deliberately generous -- a legitimately busy run keeps
# heartbeat-refreshing its claim well under this ceiling.
PIPELINE_RUN_DEADLINE_SECONDS=2700.0
# Off in dev/test: the scheduler waits for an accepted request wakeup. Production
# always polls durable queued work; this flag explicitly enables polling in dev.
PIPELINE_WORKER_AUTOSTART=false

# ---- Dashboard accuracy self-reporting (V-021, D-012) ------------------------
ESCALATION_BUDGET=0.20

# ---- Self-consistency voting & confidence gate (V-022/V-023, D-006/D-011) ---
# Agreement below this fraction escalates to the instructor even when a
# 2-of-3 majority verdict exists. 1.0 = ANY disagreement escalates (start
# strict, loosen only once V-025's golden-set agreement justifies it).
ESCALATION_AGREEMENT_THRESHOLD=1.0
# Owner decision 2026-10-29. "decide": every criterion with at least one
# verified grading pass gets a grade (majority; three-way split -> middle
# level; one verified pass or an unverified tie-break -> lower level; an
# unconfirmed evidence-support check is shown as a caution) and instructors
# change any grade they disagree with. "escalate": the earlier policy, where
# any disagreement waits for the instructor (the agreement threshold above
# applies only in this mode).
GRADING_DECISION_POLICY=decide

# ---- Accuracy gates: tier promotion + override alarm (V-025, D-012) ---------
TIER_PROMOTION_AGREEMENT=0.90
# BUG-030: was 20, stale since the original V-008 commit. V-053 raised
# config.py's in-code default to 35 for a specific arithmetic reason — a
# 0.90 Wilson lower bound is unreachable below n=35 even at 100% observed
# agreement (n=20 perfect only clears 0.839) — but this file was never
# updated to match, so `cp .env.example .env` (README.md's documented
# setup path) silently overrides the real default back down to a value
# that can never clear the promotion bar, with no error or symptom.
TIER_PROMOTION_MIN_N=35
# Deferred under carried-forward gap G2 (override-rate alerting is not yet
# computed on the dashboard; kept in Settings for schema compatibility).
# OVERRIDE_ALERT_RATE=0.15

# ---- Auth (V-014) -------------------------------------------------------------
SESSION_COOKIE_NAME=veridical_session
SESSION_TTL_HOURS=12
# true in production (Render TLS) — false locally (plain http://localhost).
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300.0

# ---- External citation-verification APIs (V-028) -----------------------------
# Contact info sent to CrossRef/Open Library for their higher "polite"/
# "identified" rate tiers (both providers' own usage policy — not a secret).
EXTERNAL_CONTACT_EMAIL=veridical@example.org
# Optional — unset works today against the unauthenticated rate tier for
# each provider (RESEARCH.md §2); set once obtained for a higher ceiling.
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_BOOKS_API_KEY=
EXTERNAL_HTTP_TIMEOUT_SECONDS=15.0
EXTERNAL_MAX_RETRIES=2
EXTERNAL_RETRY_BASE_SECONDS=1.0
CROSSREF_SINGLE_RPS=10.0
CROSSREF_LIST_RPS=3.0
SEMANTIC_SCHOLAR_RPS=1.0
OPENLIBRARY_RPS=3.0
# Conservative public requests until explicitly configured with a real contact.
# Both rates must be positive and finite; fractional rates are supported.
OPENLIBRARY_UNIDENTIFIED_RPS=1.0
# Opt-in is an operator assertion, not independent provider approval.
# The shipped example contact never enables the identified ceiling or mailto.
OPENLIBRARY_IDENTIFIED_REQUESTS=false
OPENLIBRARY_PLACEHOLDER_CONTACT_DOMAINS=["example.com","example.net","example.org","invalid","localhost","test"]
GOOGLE_BOOKS_DAILY_QUOTA=1000
# Re-checked (retraction status especially) even on a cache hit past this age.
CITATION_CACHE_STALE_DAYS=30

# ---- Claim-support check (V-030, F5.4) ----------------------------------------
# Chunk size for batched Gemini claim/abstract judgment calls (D-001/D-011
# quota discipline) — local NLI was measured and ruled out, see DECISIONS.md
# D-011 follow-up (487MB peak RSS, doesn't fit Render's 512MB free tier).
CLAIM_SUPPORT_MAX_PAIRS_PER_CALL=20
# Total eligible claim/reference occurrences admitted per manuscript, in reference
# order then occurrence order. Overflow stays unassessed and prevents completeness.
# With both defaults at20, F5 uses at most one logical support batch per run;
# provider retry/model fallback attempts remain separately quota-governed.
CLAIM_SUPPORT_MAX_PAIRS_PER_RUN=20

# ---- Statistical forensics: extraction (V-031, F6.1) --------------------------
# Override the packaged table-column-header synonym file. Empty = packaged
# default (app/checks/forensics/data/forensics_keywords.json).
FORENSICS_KEYWORDS_FILE=
FORENSICS_SPRITE_POLICY_FILE=
# F6.3 only accepts explicit native-table scale/item/unit/sample-SD declarations.
# Failed bounded searches stay unassessed; candidate witnesses never authenticate raw data.
FORENSICS_SPRITE_MAX_ROWS=3
FORENSICS_SPRITE_MAX_INPUT_ROWS=50
FORENSICS_SPRITE_MAX_RECEIPT_ROWS=50
FORENSICS_SPRITE_MAX_OBSERVATIONS=1000
FORENSICS_SPRITE_MAX_SCALE_POINTS=1000
FORENSICS_SPRITE_MAX_ITERATIONS=2000
FORENSICS_SPRITE_ROW_TIMEOUT_SECONDS=3
FORENSICS_SPRITE_CHECK_TIMEOUT_SECONDS=9
# Child-only scientific thread limit; does not change the web process.
FORENSICS_SPRITE_MATH_THREADS=1
FORENSICS_SPRITE_RANDOM_SEED=0
FORENSICS_SPRITE_INIT_METHOD=minvar

# ---- Anchor-to-region recovery (V-065 Q2, shared with V-070) -----------------
# Candidate excerpt lengths tried, longest first, against PyMuPDF's
# page.search_for() to recover a bounding box from a flag's stored
# evidence_excerpt. Measured 2026-08-19 against a real 47-page manuscript's
# real flags: quoted-prose excerpts hit at full length; shorter prefixes
# catch truncated/ellipsised excerpts that won't match verbatim in full.
REGION_SEARCH_CANDIDATE_LENGTHS=400,120,80,40
# Below this many characters a "match" is too likely to be coincidental to
# trust as a real highlight.
REGION_SEARCH_MIN_CANDIDATE_CHARS=8

# ---- Originality/reuse corpus (V-036/V-037/V-072, F7) ------------------------
# BUG-180: unbounded, an oversized upload could become hundreds of
# thousands of embedded rows in the GLOBALLY SHARED reuse corpus,
# degrading match quality/query time for every other account permanently.
# Nonnegative Library passage budget (zero disables passage entries): prepare
# and store only the existing ordered
# prefix and retain exact found/indexed counts. Whole-document/section work
# and source inventory counting have separate costs. This does not truncate
# the manuscript being checked or imply full original-source coverage.
REUSE_MAX_PASSAGES_PER_MANUSCRIPT=5000
# Maximum passage texts per local encoder call (positive integer). This setting
# does not truncate the passage inventory and is not a total work/output cap.
REUSE_PASSAGE_EMBEDDING_BATCH_SIZE=512

# ---- Library (V-066, F7.1/F7.2 surfaces) --------------------------------------
# How many chapters' worth of passage excerpt the library shows for a
# manuscript the viewing instructor does NOT own -- the bounded,
# CONFIGURABLE excerpt Q2's ruling requires (owner, 2026-08-11, carried
# from V-058/BUG-050 Branch B). One representative passage per chapter,
# capped at this many chapters.
LIBRARY_EXCERPT_MAX_CHAPTERS=5
# V-077: Library submissions spend no Gemini quota but are real CPU/storage
# work, so they get their own per-instructor budget (same window as
# ACTION_RATE_LIMIT_WINDOW_SECONDS); seeding a past term can mean dozens of
# files at once. Authors stored per Library entry are capped.
LIBRARY_SUBMISSION_RATE_LIMIT_MAX_ATTEMPTS=60
# An entry still processing after this many seconds is treated as stalled.
LIBRARY_PROCESSING_STALLED_SECONDS=600
LIBRARY_ENTRY_MAX_AUTHORS=20

# ---- Durable object storage (BUG-138) ---------------------------------------
# Render's free-tier disk is EPHEMERAL -- wiped on every redeploy/idle-wake.
# "local" (default) = data_dir is the whole store, fine for dev/CI. "r2" also
# persists uploads + extraction JSON to Cloudflare R2 (10GB-month free,
# free egress) -- production sets this and the four values below.
STORAGE_BACKEND=local
# Required for nonproduction R2 databases; all originals, raw stores, staging
# and compute artifacts use this namespace. Do not change it for existing data
# without an explicit object migration. Empty preserves legacy production keys.
STORAGE_NAMESPACE=
SOURCE_READER_MAX_MB=256
# Larger originals use a request-private disk snapshot instead of complete RAM buffers.
SOURCE_READER_MEMORY_THRESHOLD_BYTES=1048576
# A transaction holding a manuscript's source lock may wait this long between
# statements while a large source is rendered or streamed. It is raised for
# that transaction only, because the server ends idle transactions sooner
# (Neon: 5 minutes). Seconds (at most 86400), not milliseconds. 0 keeps the
# server's own limit.
SOURCE_READ_IDLE_TRANSACTION_TIMEOUT_SECONDS=1800
# Explicit maintenance/helper-only access to the legacy unscoped bucket layout.
STORAGE_ALLOW_UNSCOPED_ACCESS=false
# Bounded source-cache downloads; also used for exact competing-fill comparison.
STORAGE_DOWNLOAD_CHUNK_BYTES=1048576
STORAGE_TRANSFER_CHUNK_BYTES=8388608
# Separate private native-compute helper. Empty URL keeps local parsing.
NATIVE_COMPUTE_URL=
NATIVE_COMPUTE_SECRET=
NATIVE_COMPUTE_TIMEOUT_SECONDS=240
NATIVE_COMPUTE_JOB_TTL_SECONDS=300
# Keep at least the deployed helper's maximum function lifetime (300 seconds).
NATIVE_COMPUTE_RUNTIME_LIMIT_SECONDS=300
# Align signed expiry to the helper's HTTPS Date while retaining the caller's TTL bound.
NATIVE_COMPUTE_ALIGN_CLOCK=false
NATIVE_COMPUTE_MAX_REQUEST_BYTES=131072
NATIVE_COMPUTE_MAX_SOURCE_MB=256
NATIVE_COMPUTE_MAX_RESULT_MB=32
NATIVE_COMPUTE_MAX_CROP_MB=16
NATIVE_COMPUTE_MAX_CROP_PIXELS=25000000
NATIVE_COMPUTE_RESULTS_SUBDIR=native_compute
# Enable only with private R2 CORS, native compute, and migration0044 verified.
DIRECT_MANUSCRIPT_UPLOAD_ENABLED=false
# r2 requires private-bucket CORS; relay streams through the existing app proxy.
DIRECT_UPLOAD_TRANSPORT=r2
DIRECT_UPLOAD_RELAY_TRANSFERS=1
DIRECT_MANUSCRIPT_UPLOAD_MAX_MB=150
# Presigned links stay bound to one staging key and exact byte lengths.
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
# Browser multipart to R2 (needs bucket CORS allowing PUT from the web origin).
# R2 requires parts of at least 5 MiB and equal sizes except the last.
DIRECT_UPLOAD_PART_MB=8
DIRECT_UPLOAD_PART_CONCURRENCY=4
DIRECT_UPLOAD_PART_RETRIES=3
# Relay streaming: parts queued behind the one being stored (memory bound).
DIRECT_UPLOAD_RELAY_QUEUED_PARTS=1
# Drop a streamed upload that sends nothing for this many seconds.
DIRECT_UPLOAD_RELAY_IDLE_SECONDS=60
# Whole-file hash results reused while the file is unchanged on disk.
SOURCE_DIGEST_MEMO_ENTRIES=64
DIRECT_UPLOAD_PENDING_PER_INSTRUCTOR=3
DIRECT_UPLOAD_PENDING_GLOBAL=12
DIRECT_UPLOAD_LEASE_SECONDS=1800
DIRECT_UPLOAD_POLL_SECONDS=3
DIRECT_UPLOAD_STAGING_SUBDIR=upload_staging
DIRECT_UPLOAD_STAGING_RETENTION_SECONDS=86400
# Reserve original+staging bytes before signing/transferring; leave free-tier headroom.
DIRECT_UPLOAD_STORAGE_BUDGET_MB=8192
DIRECT_UPLOAD_CLEANUP_BATCH_SIZE=10
# Server-owned source directory relative to DATA_DIR. Changing this does not
# migrate existing paths/objects; retain it for an existing deployment.
MANUSCRIPT_UPLOAD_SUBDIR=uploads
# Required-format originals are currently local; this does not migrate old paths.
RUBRIC_UPLOAD_SUBDIR=rubric_uploads
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# V-078: on-demand file metadata checks only; no automatic polling/download.
# Transport timeouts are separate, not a universal wall-clock deadline.
STORAGE_PROBE_CONNECT_TIMEOUT_SECONDS=2
STORAGE_PROBE_READ_TIMEOUT_SECONDS=2
# Includes the initial request. 1 disables remote retries.
STORAGE_PROBE_TOTAL_ATTEMPTS=1
# Independent per-instructor budget within ACTION_RATE_LIMIT_WINDOW_SECONDS.
# In-process throttle, reset on restart; not a provider-wide billing cap.
STORAGE_PROBE_RATE_LIMIT_MAX_ATTEMPTS=60

# ---- CORS (V-048) ------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty = no CORS
# middleware (dev has no cross-origin caller yet). Production sets this to
# exactly the Vercel production origin, e.g.:
#   CORS_ALLOWED_ORIGINS=https://veridical.vercel.app
CORS_ALLOWED_ORIGINS=

# V-081: bounded group-name uniqueness retries; each attempt uses a SAVEPOINT.
GROUP_CREATE_MAX_ATTEMPTS=3

# V-081: each PDF evidence image preserves source pixels and appends a mode
# notice outside them. Limit the complete RGB raster before allocation.
# This is a per-image bound, not a process-memory or hosting-capacity guarantee.
EXPORT_PAGE_IMAGE_MAX_PIXELS=25000000
EXPORT_PAGE_IMAGE_DPI=150
# Presentation only; stored calculation/audit values are not rounded or changed.
EXPORT_NUMERIC_DETAIL_DECIMAL_PLACES=1
EXPORT_PAGE_IMAGE_MAX_HEIGHT=420
EXPORT_PAGE_DISCLOSURE_FONT_PT=8

# Optional PDF Page text: local-cache only, no cold whole-object download.
# Bounds cover Python reads/output/admission, not native parser RSS/time.
PDF_PAGE_TEXT_SLOTS=1
# Recorded source evidence: native-work admission and bounded image batches.
# These are resource caps, not grading or placement-confidence thresholds.
EVIDENCE_SOURCE_SLOTS=1
EVIDENCE_SOURCE_MAX_HIGHLIGHT_BOXES=128
# Retained encoded PNG response/batch bytes; not discarded compression work.
EVIDENCE_SOURCE_MAX_RENDERED_BYTES=16777216
# Raster pixel reservations are charged even if an encoded image is withheld.
EVIDENCE_SOURCE_MAX_RENDERED_PIXELS=48000000
# Bound the retained extraction JSON read for source-linked DOCX navigation.
EVIDENCE_SOURCE_MAX_EXTRACTION_BYTES=33554432
EVIDENCE_SOURCE_RATE_LIMIT_MAX_ATTEMPTS=120
PDF_PAGE_TEXT_RAW_MAX_BYTES=33554432
PDF_PAGE_TEXT_MAX_BLOCKS=256
PDF_PAGE_TEXT_MAX_CHARS=40000
PDF_PAGE_TEXT_MAX_BYTES=262144
# Per instructor in ACTION_RATE_LIMIT_WINDOW_SECONDS; no automatic retry loop.
PDF_PAGE_TEXT_RATE_LIMIT_MAX_ATTEMPTS=120
# Public HTTPS practice site ending in /demo; blank disables prepared review.
# Use a separate origin from the instructor account site.
VITE_PRACTICE_WORKSPACE_URL=
# Disposable prepared report PDFs (single backend worker, no durable queue).
EXPORT_JOB_TTL_SECONDS=600
EXPORT_JOB_MAX_BYTES=33554432
EXPORT_JOB_POLL_SECONDS=3
EXPORT_JOB_WAIT_SECONDS=900
